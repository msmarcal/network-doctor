RED, YELLOW, GREEN, BOLD, RESET = (
    "\033[0;31m", "\033[1;33m", "\033[0;32m", "\033[1m", "\033[0m")


class Painter(object):
    def __init__(self, enabled):
        self.enabled = enabled

    def __call__(self, text, color):
        if not self.enabled:
            return text
        return "%s%s%s" % (color, text, RESET)


def _plural(count, noun, suffix="s"):
    return "%d %s%s" % (count, noun, "" if count == 1 else suffix)


def _coverage_lines(coverage):
    lines = []
    inputs = ["status: %s" % coverage["source"]]
    iperf = coverage["iperf"]
    if iperf["present"] and iperf.get("format_ok"):
        label = "iperf: %s" % iperf["path"]
        if iperf.get("discovered"):
            label += " (found beside the status file)"
        inputs.append(label)
    elif iperf["present"]:
        inputs.append("iperf: %s (not in the expected format, ignored)" % iperf["path"])
    else:
        inputs.append("iperf: not supplied, no throughput data")
    lines.append("inputs   " + " | ".join(inputs))

    icmp_label = {
        "complete": "measured on every unit",
        "leader-only": "measured from the leader only",
        "partial": "measured on some units only",
        "none": "not measured on any unit",
    }[coverage["icmp"]]
    scope = "scope    %s, %s | icmp: %s" % (
        _plural(coverage["machines"], "machine"),
        _plural(coverage["spaces"], "space"), icmp_label)
    lines.append(scope)

    if iperf["present"] and iperf.get("format_ok"):
        topologies = iperf.get("topology") or {}
        stars = sorted(set(t["source"] for t in topologies.values() if t["kind"] == "star"))
        if stars:
            shape = "star from %s" % ", ".join(stars)
        elif topologies:
            shape = "mesh"
        else:
            shape = "no measurements"
        lines.append("iperf    %d measurements, %s" % (iperf.get("measurements", 0), shape))

    counts = "quality  %s" % _plural(coverage["unparsed_messages"], "unparsed message")
    if iperf["present"] and iperf.get("format_ok"):
        counts += ", %s" % _plural(iperf.get("malformed_rows", 0), "malformed row")
    lines.append(counts)
    return lines


def render_text(model, verdicts, paint):
    coverage = model["coverage"]
    status = model["status"]
    out = []
    out.append(paint("NETWORK DOCTOR", BOLD) + "   model: %s" % (status["model_name"] or "unknown"))
    out.extend(_coverage_lines(coverage))
    out.append("")

    if verdicts:
        for index, verdict in enumerate(verdicts, 1):
            color = RED if verdict["tier"] == 0 or verdict["kind"] in (
                "space-wide", "host-connectivity", "mtu-class", "cross-zone",
                "throughput-host", "unsupported-charm") else YELLOW
            out.append(paint("[%d] %s" % (index, verdict["title"]), color))
            if verdict["spaces"]:
                out.append("    spaces     %s" % ", ".join(verdict["spaces"]))
            if verdict["hosts"]:
                out.append("    hosts      %s" % ", ".join(verdict["hosts"]))
            out.append("    evidence")
            for line in verdict["evidence"]:
                out.append("      %s" % line)
            out.append("    reading")
            for line in _wrap(verdict["reasoning"], 68):
                out.append("      %s" % line)
            out.append("")
    else:
        caveats = []
        if coverage["icmp"] == "none":
            caveats.append("Every unit reports 'icmp skipped', so this result says "
                           "nothing about reachability. Enable ping_mesh_mode on "
                           "the Magpie charm.")
        elif coverage["icmp"] != "complete":
            caveats.append("ICMP was %s, so unmeasured pairs are unknown rather "
                           "than healthy." % {
                               "leader-only": "measured from the leader only",
                               "partial": "measured on some units only",
                           }[coverage["icmp"]])
        if coverage["unparsed_messages"]:
            count = coverage["unparsed_messages"]
            caveats.append("%d status message%s could not be parsed and %s listed "
                           "below, so the checks %s carried were not evaluated."
                           % (count, "" if count == 1 else "s",
                              "is" if count == 1 else "are",
                              "it" if count == 1 else "they"))
        if caveats:
            out.append(paint("No faults found in what could be measured.", YELLOW))
            for caveat in caveats:
                out.extend(_wrap(caveat, 72))
        else:
            out.append(paint("No faults found.", GREEN))
            out.append("ICMP was measured on every unit and every message parsed.")
        out.append("")

    unparsed = [(space_name, unit) for space_name, space in sorted(status["spaces"].items())
                for unit in space["units"].values() if unit["form"] in ("unparsed", "partial")]
    if unparsed:
        out.append(paint("UNRECOGNIZED STATUS MESSAGES", YELLOW))
        for space_name, unit in unparsed:
            out.append("  %s %s: %s" % (space_name, unit["unit"],
                                        unit["unrecognized"] or unit["raw"]))
        out.append("")

    return "\n".join(out).rstrip() + "\n"


def _wrap(text, width):
    words, lines, current = text.split(), [], ""
    for word in words:
        if current and len(current) + 1 + len(word) > width:
            lines.append(current)
            current = word
        else:
            current = (current + " " + word).strip()
    if current:
        lines.append(current)
    return lines


