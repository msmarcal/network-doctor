def build_model(status_document, source_name, iperf):
    status = load_status(status_document, source_name)
    model = {"status": status, "iperf": iperf}
    coverage = build_coverage(status, iperf)
    coverage["source"] = source_name
    model["coverage"] = coverage
    return model


def parse_args(argv):
    parser = argparse.ArgumentParser(
        prog="network-doctor",
        description="Diagnose Juju Magpie network results.")
    parser.add_argument("status", nargs="?", default=None,
                        help="juju status JSON file; reads standard input when omitted")
    parser.add_argument("--iperf", default=None,
                        help="Magpie iperf CSV; looked for beside the status file when omitted")
    parser.add_argument("--json", action="store_true", dest="as_json",
                        help="emit the normalized model and verdicts as JSON")
    parser.add_argument("--no-color", action="store_true",
                        help="never emit ANSI color, even on a terminal")
    return parser.parse_args(argv)


def main(argv=None):
    args = parse_args(sys.argv[1:] if argv is None else argv)

    if args.status is None:
        source_name = "<stdin>"
        raw = sys.stdin.read()
    else:
        if not os.path.isfile(args.status):
            sys.stderr.write("error: status file not found: %s\n" % args.status)
            return 1
        source_name = args.status
        with open(args.status) as handle:
            raw = handle.read()
    try:
        document = json.loads(raw)
    except ValueError as exc:
        sys.stderr.write("error: %s is not valid JSON: %s\n" % (source_name, exc))
        return 1
    if not isinstance(document, dict) or "applications" not in document:
        sys.stderr.write("error: %s does not look like juju status output\n" % source_name)
        return 1

    iperf_path, discovered = args.iperf, False
    if iperf_path is None and args.status is not None:
        sibling = os.path.join(os.path.dirname(os.path.abspath(args.status)), "iperf.csv")
        if os.path.isfile(sibling):
            iperf_path, discovered = sibling, True
    iperf = None
    if iperf_path is not None:
        if not os.path.isfile(iperf_path):
            sys.stderr.write("error: iperf file not found: %s\n" % iperf_path)
            return 1
        iperf = load_iperf(iperf_path)
        iperf["discovered"] = discovered

    model = build_model(document, source_name, iperf)
    verdicts = diagnose(model)

    if args.as_json:
        sys.stdout.write(json.dumps(
            {"coverage": model["coverage"], "model": model["status"],
             "measurements": iperf["measurements"] if iperf else [],
             "verdicts": verdicts},
            indent=2, sort_keys=True) + "\n")
    else:
        color = sys.stdout.isatty() and not args.no_color
        sys.stdout.write(render_text(model, verdicts, Painter(color)))

    return 2 if verdicts else 0


if __name__ == "__main__":
    sys.exit(main())
